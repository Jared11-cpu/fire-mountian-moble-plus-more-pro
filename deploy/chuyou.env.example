# The API process listens only on the ECS loopback interface.
HOST=127.0.0.1
PORT=8787

# Server-only credentials. Never add a VITE_ prefix and never commit real values.
AMAP_WEB_SERVICE_KEY=
AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
AI_BASE_URL=
AI_EXTRACT_MODEL=qwen-flash
AI_RECOMMEND_MODEL=qwen-plus

# Comma-separated production frontend origins.
ALLOWED_ORIGINS=https://cwychuyouai.online,https://www.cwychuyouai.online

# Non-secret release identity, written by the deploy step (git rev-parse HEAD / date -u).
# Returned by GET /api/health as build.sha / build.builtAt so frontend and API versions can be matched.
API_BUILD_SHA=
API_BUILT_AT=
